
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TelegramUser {
  id               String          @id @default(cuid())
  telegramId       BigInt          @unique
  telegramUsername String?
  firstName        String?
  lastName         String?
  language         String          @default("am")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  tickets          LotteryTicket[]

  @@map("telegram_users")
}

model LotteryTicket {
  id                String       @id @default(cuid())
  telegramUserId    String
  user              TelegramUser @relation(fields: [telegramUserId], references: [id], onDelete: Cascade)
  ticketNumber      String
  originalSms       String       @db.Text
  expirationDateText String
  drawDateText      String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([telegramUserId, ticketNumber, drawDateText])
  @@index([telegramUserId])
  @@map("lottery_tickets")
}

enum DrawStatus {
  DRAFT
  VERIFIED
  PUBLISHED
}

model LotteryDraw {
  id              String       @id @default(cuid())
  drawCode        String       @unique
  drawDateText    String
  status          DrawStatus   @default(DRAFT)
  sourceReference String?
  notes           String?      @db.Text
  verifiedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  prizes          DrawPrize[]

  @@index([status])
  @@index([drawDateText])
  @@map("lottery_draws")
}

model DrawPrize {
  id            String      @id @default(cuid())
  drawId        String
  draw          LotteryDraw @relation(fields: [drawId], references: [id], onDelete: Restrict)
  prizeName     String
  winningNumber String
  prizeAmount   Decimal?    @db.Decimal(12, 2)
  currency      String      @default("ETB")
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([drawId, prizeName, winningNumber])
  @@index([drawId])
  @@map("draw_prizes")
}
